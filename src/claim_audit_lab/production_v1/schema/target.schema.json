{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/camerontjs-dot/claim-audit-lab/schemas/cal-v1-target-v1.schema.json",
  "title": "CAL V1 Contract B Typed Target",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "proposition"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition_id", "text_sha256", "semantic_family", "fields"],
      "properties": {
        "proposition_id": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_family": {
          "enum": [
            "strict_comparison",
            "direct_event_order",
            "permission_exception",
            "assertion_scope",
            "unsupported"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

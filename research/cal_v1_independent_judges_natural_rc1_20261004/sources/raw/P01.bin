  <h1 class="uswds-page-title page-title">Capital Punishment, 2023 – Statistical Tables</h1>


  </div>
<div id="block-ojp-content" data-block-plugin-id="system_main_block" class="block block-system block-system-main-block">
  
    
      

<article>

  
    

  
  <div>

    
      

<script>
var curGeo = '0';
 function geoChange() {
 var myselect = document.getElementById("select_geo");
 var myGeo = myselect.options[myselect.selectedIndex].value;
 //hide curGeo
 var myIndicator = document.getElementById("geo" + curGeo);
 myIndicator.setAttribute('class', 'indicator-box indicator-hide');
 curGeo = myGeo;
 //display curGeo
 myIndicator = document.getElementById("geo" + curGeo);
 myIndicator.setAttribute('class', 'indicator-box indicator-show');
}
</script>

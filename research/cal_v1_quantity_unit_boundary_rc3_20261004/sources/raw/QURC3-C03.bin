<section>

<div class="row">
  <div class="col-md-12">
	<h1 property="name" id="wb-cont">Business conditions in Canada, fourth quarter of 2025<a class="wb-lbx ndm-correction wb-init wb-lbx-inited" role="button" aria-controls="correction-notice" style="text-decoration:none;" aria-label="corrections" href="#correction-notice"></a></h1>

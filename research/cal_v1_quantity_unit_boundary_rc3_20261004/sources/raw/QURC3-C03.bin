<!--startindex-->

<div class="row">
	<div class="col-md-8">
		<span class="label label-primary mrgn-rght-md"><strong>Release date:</strong> November 25, 2025</span>
		<span class="label label-warning"><strong>Correction date:</strong> March 18, 2026</span>
	</div>
	<div class="col-md-4">
	<div class="pull-right mrgn-bttm-sm mrgn-tp-sm">
		<!--<a href="/eng/covid19" role="button" class="btn btn-primary btn-xs">COVID-19: A data perspective</a>-->
